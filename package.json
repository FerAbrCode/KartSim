{
  "name": "kartsim",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch server.ts",
    "dev:server": "bun --watch server.ts",
    "dev:client": "bun run build:watch",
    "build": "bun build src/client/main.ts --outdir public/build --entry-naming=[name].js --sourcemap",
    "build:watch": "bun build src/client/main.ts --outdir public/build --entry-naming=[name].js --sourcemap --watch",
    "start": "bun server.ts"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/bun": "^1.3.5"
  }
}
